# Absolute site URL used for canonical links, Open Graph, sitemap, and schema.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required before anyone can sign in at /admin. Set both in the hosting UI.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional. When all five are set, inquiries are stored in GoDaddy MySQL.
# Otherwise they are stored in data/inquiries.json on the server.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
